; shclib.src  Compiler run-time library: division, modulo, block move and shifts
;
; Arithmetic helpers called by compiled C code, with operands passed in registers.
; __divls / __divlu are the signed and unsigned 32-bit divides and __divws the 16-bit signed
; divide, built on the SH-2 DIV0/DIV1 step instructions; __modls / __modlu return the signed
; and unsigned remainders. __quick_mvn is the fast block move for structure copies.
; __sftl and __sftra are the variable-count left and arithmetic-right shifts: counts of 32 or
; more give the saturated result, other counts jump through a byte offset table into an
; unrolled run of shift instructions (sharing the logical-shift tail in slow_mvn.src).

          .CPU        SH2
          .IMPORT     sftrl_in_range
          .IMPORT     _errno
          .EXPORT     __divls
          .EXPORT     __divlu
          .EXPORT     __divws
          .EXPORT     __modls
          .EXPORT     __modlu
          .EXPORT     __quick_mvn
          .EXPORT     __sftl
          .EXPORT     __sftra
          .EXPORT     _sftra_neg_rotl
          .SECTION    P,CODE,ALIGN=4
__divls:
